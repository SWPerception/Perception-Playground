          <sensor name="imu" type="imu">
              <always_on>true</always_on>
              <update_rate>100</update_rate>
              <imu>
                  <angular_velocity>
                      <x>
                          <noise type="gaussian">
                              <mean>0</mean>
                              <stddev>0</stddev>
                          </noise>
                      </x>
                      <y>
                          <noise type="gaussian">
                              <mean>0</mean>
                              <stddev>0</stddev>
                          </noise>
                      </y>
                      <z>
                          <noise type="gaussian">
                              <mean>0</mean>
                              <stddev>0</stddev>
                          </noise>
                      </z>
                  </angular_velocity>
                  <linear_acceleration>
                      <x>
                          <noise type="gaussian">
                              <mean>0</mean>
                              <stddev>0</stddev>
                          </noise>
                      </x>
                      <y>
                          <noise type="gaussian">
                              <mean>0</mean>
                              <stddev>0</stddev>
                          </noise>
                      </y>
                      <z>
                          <noise type="gaussian">
                              <mean>0</mean>
                              <stddev>0</stddev>
                          </noise>
                      </z>
                  </linear_acceleration>
              </imu>
              <plugin name="imu_plugin_for_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
                  <ros>
                      <remapping>~/out:=imu_sensor/imu</remapping>
                  </ros>
              </plugin>
